# Local development. AWS credentials are resolved by boto3's standard chain
# (AWS_PROFILE locally, IAM role when deployed).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintech
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
S3_BUCKET_NAME=
CORS_ALLOWED_ORIGINS=http://localhost:3000
SIGNED_URL_EXPIRATION_MINUTES=15
UPLOAD_URL_EXPIRATION_MINUTES=10
MAX_UPLOAD_SIZE_MB=25
MAX_FINANCING_PCT_OF_PO=0.80
